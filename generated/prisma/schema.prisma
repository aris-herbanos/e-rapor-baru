generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id              Int     @id @default(autoincrement())
  identity_number String  @unique
  password        String
  fullname        String
  birth_date      String?
  education       String?
  address         String?
  role            String  @default("TEACHER")

  assignments Assignment[]
  subjects    Subject[]
}

model Subject {
  id        Int    @id @default(autoincrement())
  name      String
  teacherId Int

  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignments  Assignment[]
  cps          CP[]
  scoreRecords ScoreRecord[]

  @@index([teacherId])
}

model CP {
  id          Int    @id @default(autoincrement())
  code        String
  description String
  subjectId   Int

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tps     TP[]

  @@index([subjectId])
}

model TP {
  id          Int    @id @default(autoincrement())
  code        String
  description String
  cpId        Int

  cp          CP           @relation(fields: [cpId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([cpId])
}

model Student {
  id         Int     @id @default(autoincrement())
  nisn       String  @unique
  fullname   String
  birth_info String?
  gender     String
  class_name String
  address    String?

  assessments  Assessment[]
  attendances  Attendance[]
  homeroomNote HomeroomNote?
  personality  Personality?
  scoreRecords ScoreRecord[]
  tahfidzs     Tahfidz[]

  @@index([class_name])
}

model Assessment {
  id        Int    @id @default(autoincrement())
  studentId Int
  tpId      Int
  score     Int
  type      String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tp      TP      @relation(fields: [tpId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tpId])
}

model Tahfidz {
  id        Int      @id @default(autoincrement())
  studentId Int
  juz       Int
  surah     String
  ayat      String
  predicate String
  date      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  status    String
  date      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
}

model ClassRoom {
  id     Int    @id @default(autoincrement())
  name   String @unique
  level  String
  grade  Int
  status String @default("Aktif")

  @@index([level])
  @@index([grade])
}

model Assignment {
  id           Int    @id @default(autoincrement())
  teacherId    Int
  subjectId    Int
  className    String
  academicYear String @default("2026/2027")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, className, academicYear])
  @@index([teacherId])
  @@index([subjectId])
  @@index([className])
}

model ScoreRecord {
  id          Int    @id @default(autoincrement())
  studentId   Int
  subjectId   Int
  className   String
  type        String
  scoreNumber Int    @default(0)
  scoreText   String @default("")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, type])
  @@index([studentId])
  @@index([subjectId])
  @@index([className])
}

model Personality {
  id         Int    @id @default(autoincrement())
  studentId  Int    @unique
  className  String
  suluk      String @default("-")
  muwadhotah String @default("-")
  nadzofah   String @default("-")
  indhiplat  String @default("-")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([className])
  @@index([studentId])
}

model HomeroomNote {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  className String
  note      String   @default("")
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([className])
  @@index([studentId])
}

model SystemSetting {
  id            Int      @id @default(autoincrement())
  schoolName    String   @default("Pondok Pesantren Terpadu Ulul Albab")
  academicYear  String   @default("2026/2027")
  semester      String   @default("Ganjil")
  principalName String   @default("Pimpinan Pesantren")
  updatedAt     DateTime @updatedAt
}
